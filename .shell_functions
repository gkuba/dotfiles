# Extracts any archive(s)
extract() {
    for archive in "$@"; do
        if [ -f "$archive" ]; then
            case "$archive" in
                *.tar.bz2) tar xvjf "$archive" ;;
                *.tar.gz)  tar xvzf "$archive" ;;
                *.bz2)     bunzip2 "$archive" ;;
                *.rar)     rar x "$archive" ;;
                *.gz)      gunzip "$archive" ;;
                *.tar)     tar xvf "$archive" ;;
                *.tbz2)    tar xvjf "$archive" ;;
                *.tgz)     tar xvzf "$archive" ;;
                *.zip)     unzip "$archive" ;;
                *.Z)       uncompress "$archive" ;;
                *.7z)      7z x "$archive" ;;
                *)         echo "don't know how to extract '$archive'..." ;;
            esac
        else
            echo "'$archive' is not a valid file!"
        fi
    done
}

# Show current network information (cleaner, jq-free)
netinfo() {
    echo "=== Network Information ==="

    # IP Addresses
    ip -4 addr show | awk '
        /inet / && $2 != "127.0.0.1/8" {
            gsub(/\/[0-9]+/, "", $2)
            interface = $NF
            printf "Device :  %s\n", interface
            printf "Address:  %s\n", $2
            printf "----------------------------\n"
        }
    '

    # MAC Addresses (Cleaned Trailing Interface Colons)
    ip link show | awk '
        /link\/ether/ {
            interface = $2
            mac = $3
            gsub(/:/, "", interface)
            gsub(/:/, "", mac)
            printf "MACAddr:  %s (%s)\n", mac, interface
        }
    '
}

# IP address lookup - Tight aligned output
whatsmyip() {
    echo "Fetching IP information..."

    # Get External IP with reliable fallbacks
    EXTERNAL_IP="$(curl -s --max-time 6 https://api.ipify.org 2>/dev/null || \
                   curl -s --max-time 6 https://icanhazip.com 2>/dev/null || \
                   curl -s --max-time 6 https://ifconfig.me 2>/dev/null || \
                   echo "Unable to fetch external IP")"

    echo

    echo "Internal IPs:"
    ip -4 addr show | awk '
        /inet / && $2 != "127.0.0.1/8" {
            gsub(/\/[0-9]+/, "", $2)
            interface = $NF
            printf "  %-15s  %s\n", $2, interface
        }
    '

    echo
    echo -e "External IP:\t$EXTERNAL_IP"
}

