# ===================================================
# Nala-style pacman wrapper (official repos only)
# ===================================================
pacman() {
    case "$1" in
        update)
            echo "→ Syncing package databases..."
            sudo /usr/bin/pacman -Sy ${@:2} ;;
        upgrade)
            echo "→ Upgrading installed packages..."
            sudo /usr/bin/pacman -Su ${@:2} ;;
        install)
            if [ -z "${2:-}" ]; then
                echo -e "\033[31m[ERROR]\033[0m No packages specified for installation." >&2
                echo "Usage: pacman install <package_name>"
                return 1
            fi
            sudo /usr/bin/pacman -S ${@:2} ;;
        remove)
            if [ -z "${2:-}" ]; then
                echo -e "\033[31m[ERROR]\033[0m No packages specified for removal." >&2
                echo "Usage: pacman remove <package_name>"
                return 1
            fi
            sudo /usr/bin/pacman -Rns ${@:2} ;;
        autoremove)
            echo "→ Removing orphan packages..."
            local orphans=( $(/usr/bin/pacman -Qdtq) )
            if [ ${#orphans[@]} -gt 0 ]; then
                sudo /usr/bin/pacman -Rns "${orphans[@]}"
            else
                echo "✓ No orphan packages found to clear."
            fi
            ;;
        search)
            /usr/bin/pacman -Ss ${@:2} ;;
        info)
            /usr/bin/pacman -Si ${@:2} ;;
        clean)
            sudo /usr/bin/pacman -Sc ${@:2} ;;
        orphans)
            /usr/bin/pacman -Qdtq ;;
        fix)
            echo "→ Forcing database refresh and upgrading..."
            sudo /usr/bin/pacman -Syyu ${@:2} ;;
        help|--help|-h)
            echo "pacman wrapper (Nala-style)"
            echo "==========================="
            echo ""
            echo "  pacman update        →  sudo pacman -Sy"
            echo "  pacman upgrade       →  sudo pacman -Su"
            echo "  pacman install <pkg> →  sudo pacman -S <pkg>"
            echo "  pacman remove <pkg>  →  sudo pacman -Rns <pkg>"
            echo "  pacman autoremove    →  remove orphan packages"
            echo "  pacman search <term> →  pacman -Ss <term>"
            echo "  pacman info <pkg>    →  pacman -Si <pkg>"
            echo "  pacman clean         →  sudo pacman -Sc"
            echo "  pacman orphans       →  pacman -Qdtq"
            echo "  pacman fix           →  sudo pacman -Syyu"
            echo ""
            echo "Use 'pacman --real-help' for original pacman help"
            return 0
            ;;
        --real-help)
            /usr/bin/pacman --help ;;
        *)
            sudo /usr/bin/pacman --color always "$@" ;;
    esac
}

