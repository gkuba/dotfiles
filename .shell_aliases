##-------------------------------------------------------------
## Aliases
##-------------------------------------------------------------

# ── Color support and basic ls aliases ─────────────────────
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
fi

# Modern ls aliases (using eza if available, otherwise fallback)
if command -v eza >/dev/null 2>&1; then
    alias ls='eza --color=always --group-directories-first --icons'
    alias ll='eza -lh --color=always --group-directories-first --icons --git'
    alias la='eza -la --color=always --group-directories-first --icons --git'
    alias l='eza -l --color=always --group-directories-first --icons'
else
    alias ls='ls --color=auto -F'
    alias ll='ls -alF --color=auto'
    alias la='ls -A --color=auto'
    alias l='ls -CF --color=auto'
fi

# Color for other common commands
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias ip='ip -c'

# ── Intelligent / Safe Utilities ───────────────────────────
alias mkdir='mkdir -pv'
alias rm='rm -Iv'
alias cp='cp -iv'
alias mv='mv -iv'

# AMP alias
alias amp='sudo su -l amp'

# Debian-based shortcuts
if command -v nala >/dev/null 2>&1; then
    alias apt='nala'
    alias nala='sudo nala'
elif command -v apt-get >/dev/null 2>&1; then
    alias apt='sudo apt-get'
fi

# RPM-based shortcuts
if command -v dnf >/dev/null 2>&1; then
    alias dnf='sudo dnf'
elif command -v yum >/dev/null 2>&1; then
    alias yum='sudo yum --color=auto'
fi

# ── Custom function aliases ────────────────────────────────
alias whatismyip="whatsmyip"
alias wi="whatsmyip"                    # short version
