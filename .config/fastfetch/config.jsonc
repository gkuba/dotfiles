{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/images/stencil.png",
    "height": 17,
    "width": 34,
    "recache": true
  },
  "display": {
    "separator": " 󰑃  "
  },
  "modules": [
    {
      "type": "custom",
      "format": "╭────  System ─────────────────────────────────────────────╮"
    },
    {
      "type": "title",
      "key": "  Hostname",
      "format": "{host-name}"
    },
    {
      "type": "title",
      "key": "  User    ",
      "format": "{user-name}"
    },
    {
      "type": "os",
      "key": "  OS      "
    },
    {
      "type": "de",
      "key": "  DE      "
    },
    {
      "type": "terminal",
      "key": "  Terminal"
    },
    {
      "type": "shell",
      "key": "  Shell   "
    },
    {
      "type": "custom",
      "format": "╰──────────────────────────────────────────────────────────╯"
    },
    {
      "type": "custom",
      "format": "╭────  Hardware ───────────────────────────────────────────╮"
    },
    {
      "type": "board",
      "key": "  Mobo    "
    },
    {
      "type": "cpu",
      "key": "  CPU     "
    },
    {
      "type": "gpu",
      "key": "  GPU     "
    },
    {
      "type": "memory",
      "key": "  Memory  "
    },
    {
      "type": "disk",
      "key": "  Root    ",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "disk",
      "key": "  Games   ",
      "folders": "/games",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "localip",
      "key": "  Network ",
      "format": "{ipv4}"
    },
    {
      "type": "uptime",
      "key": "  Uptime  "
    },
    {
      "type": "custom",
      "format": "╰──────────────────────────────────────────────────────────╯"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
